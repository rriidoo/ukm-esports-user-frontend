:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f8fafc;
  background: #080d18;
  font-synthesis: none;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; min-width: 320px; background: #080d18; color: #f8fafc; }
button, a { font: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
.site-shell { min-height: 100vh; overflow: hidden; background: #080d18; }
.topbar {
  position: sticky; top: 0; z-index: 30; height: 78px; padding: 0 7vw;
  display: flex; align-items: center; justify-content: space-between; gap: 28px;
  border-bottom: 1px solid rgba(148,163,184,.12); background: rgba(8,13,24,.9); backdrop-filter: blur(18px);
}
.brand { display: flex; align-items: center; gap: 11px; min-width: 210px; }
.brand img { width: 38px; height: 38px; border-radius: 8px; object-fit: cover; }
.brand div { display: flex; flex-direction: column; }
.brand strong { font-size: 13px; line-height: 16px; letter-spacing: .2px; }
.brand span { margin-top: 2px; color: #7f8ba0; font-size: 9px; font-weight: 700; letter-spacing: 1.4px; }
.main-nav { display: flex; align-items: center; gap: 28px; color: #8793a8; font-size: 13px; font-weight: 600; }
.main-nav a { position: relative; padding: 29px 0 27px; }
.main-nav a:hover, .main-nav .is-active { color: #f8fafc; }
.main-nav .is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px; background: #e31b2d; }
.top-actions { display: flex; gap: 9px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 38px; padding: 0 17px; border-radius: 8px; border: 1px solid transparent; font-size: 12px; font-weight: 700; }
.button--ghost { background: #101827; border-color: #273349; color: #c6cfdd; }
.button--primary { background: #e31b2d; color: #fff; box-shadow: 0 10px 30px rgba(227,27,45,.18); }
.button--primary:hover { background: #f02034; }
.button--large { min-height: 46px; padding: 0 22px; }
.hero { position: relative; min-height: 610px; padding: 96px 8vw 78px; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(360px,.92fr); align-items: center; gap: 54px; border-bottom: 1px solid #151e2d; }
.hero__grid { position: absolute; inset: 0; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 38px 38px; mask-image: linear-gradient(to bottom, #000 0%, transparent 90%); }
.hero__glow { position: absolute; width: 420px; height: 420px; border-radius: 50%; filter: blur(100px); opacity: .12; pointer-events: none; }
.hero__glow--one { left: -120px; top: 30px; background: #e31b2d; }
.hero__glow--two { right: -100px; bottom: -140px; background: #2563eb; }
.hero__content, .hero__visual { position: relative; z-index: 1; }
.eyebrow, .section-kicker { color: #ef6b79; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; min-height: 27px; padding: 0 10px; border: 1px solid rgba(227,27,45,.24); border-radius: 99px; background: rgba(227,27,45,.08); }
.eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: #e31b2d; box-shadow: 0 0 12px rgba(227,27,45,.8); }
.hero h1 { max-width: 690px; margin: 18px 0 18px; font-size: clamp(42px, 5.1vw, 69px); line-height: .99; letter-spacing: -2.7px; }
.hero h1 em { color: #e31b2d; font-style: normal; }
.hero__content > p { max-width: 620px; margin: 0; color: #8f9bae; font-size: 15px; line-height: 1.75; }
.hero__actions { display: flex; align-items: center; gap: 20px; margin-top: 30px; }
.hero__link { display: inline-flex; align-items: center; gap: 5px; color: #aab4c5; font-size: 12px; font-weight: 700; }
.hero__visual { min-height: 410px; display: grid; place-items: center; perspective: 1200px; }
.hero-card { position: absolute; width: min(440px, 92%); aspect-ratio: 1.3; border-radius: 24px; border: 1px solid #2b384f; }
.hero-card--back { transform: rotate(7deg) translate(18px, 16px); background: linear-gradient(145deg,#151f33,#0c1320); opacity: .65; }
.hero-card--front { overflow: hidden; padding: 23px; display: flex; flex-direction: column; justify-content: space-between; background: radial-gradient(circle at 75% 30%, rgba(227,27,45,.24), transparent 34%), linear-gradient(145deg,#111a2b 5%,#080d18 95%); box-shadow: 0 26px 70px rgba(0,0,0,.38); transform: rotate(-3deg); }
.hero-card__brand { font-size: 15px; font-weight: 800; letter-spacing: 1px; }
.hero-card__brand span { color: #e31b2d; }
.hero-card__arena { position: relative; min-height: 180px; display: grid; place-items: center; color: #e31b2d; }
.hero-card__arena::before { content: ""; position: absolute; width: 135px; height: 135px; border: 1px solid rgba(227,27,45,.25); border-radius: 50%; box-shadow: 0 0 55px rgba(227,27,45,.16); }
.hero-card__beam { position: absolute; width: 1px; height: 145px; background: linear-gradient(transparent,#e31b2d,transparent); opacity: .4; }
.hero-card__beam--left { transform: rotate(65deg); }
.hero-card__beam--right { transform: rotate(-65deg); }
.hero-card__footer { display: flex; justify-content: space-between; color: #6f7b90; font-size: 9px; letter-spacing: 1.2px; }
.stats { min-height: 128px; padding: 0 8vw; display: grid; grid-template-columns: repeat(3,1fr); align-items: stretch; border-bottom: 1px solid #151e2d; background: #0b111d; }
.stats article { display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid #1b2637; }
.stats article:last-child { border-right: 0; }
.stats strong { font-size: 28px; color: #fff; }
.stats span { margin-top: 5px; color: #758198; font-size: 11px; font-weight: 600; }
.section { padding: 88px 8vw; }
.section-heading h2 { margin: 9px 0 0; font-size: clamp(29px,3.5vw,42px); letter-spacing: -1px; }
.section-heading p { max-width: 640px; margin: 13px auto 0; color: #758198; font-size: 13px; line-height: 1.7; }
.section-heading--center { text-align: center; }
.section-heading--split { display: flex; align-items: end; justify-content: space-between; gap: 28px; }
.section-heading--split a { display: inline-flex; align-items: center; gap: 6px; color: #aab4c5; font-size: 11px; font-weight: 700; }
.advantages { background: #080d18; }
.advantage-grid { max-width: 1100px; margin: 45px auto 0; display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
.advantage-grid article { min-height: 220px; padding: 28px; border: 1px solid #1e293b; border-radius: 16px; background: linear-gradient(145deg,#101827,#0c1320); }
.feature-icon { width: 50px; height: 50px; display: grid; place-items: center; border-radius: 12px; background: rgba(227,27,45,.11); color: #e85866; }
.advantage-grid h3 { margin: 20px 0 9px; font-size: 16px; }
.advantage-grid p { margin: 0; color: #748096; font-size: 12px; line-height: 1.7; }
.games-section { border-top: 1px solid #151e2d; background: #0a101b; }
.game-grid { margin-top: 34px; display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; }
.game-card { min-height: 110px; display: grid; grid-template-columns: 60px 1fr 38px; align-items: center; gap: 17px; padding: 18px 20px; border: 1px solid #1f2a3d; border-radius: 14px; background: #101827; }
.game-card:hover { border-color: #334158; background: #121c2e; }
.game-card__logo { width: 58px; height: 58px; display: grid; place-items: center; overflow: hidden; border-radius: 12px; background: #182237; color: #eef2f7; font-size: 18px; font-weight: 800; }
.game-card__logo img { width: 100%; height: 100%; object-fit: cover; }
.game-card__copy small { color: #e76471; font-size: 9px; font-weight: 800; letter-spacing: 1px; }
.game-card h3 { margin: 4px 0 4px; font-size: 15px; }
.game-card p { margin: 0; color: #718096; font-size: 10px; }
.game-card button { width: 34px; height: 34px; display: grid; place-items: center; border: 0; border-radius: 8px; background: #172236; color: #8895aa; }
.event-section { background: #080d18; }
.event-card { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: .85fr 1.15fr; overflow: hidden; border: 1px solid #1f2a3d; border-radius: 20px; background: #101827; }
.event-card__visual { min-height: 330px; position: relative; display: grid; place-items: center; background: radial-gradient(circle at 50% 45%,rgba(227,27,45,.22),transparent 30%), linear-gradient(145deg,#151f33,#0b111d); }
.event-card__visual > span { position: absolute; left: 24px; bottom: 22px; color: #6f7b90; font-size: 9px; font-weight: 800; letter-spacing: 1.4px; }
.event-mark { width: 112px; height: 112px; display: grid; place-items: center; border: 1px solid rgba(227,27,45,.35); border-radius: 50%; color: #e31b2d; box-shadow: 0 0 45px rgba(227,27,45,.12); }
.event-card__content { padding: 46px; display: flex; flex-direction: column; justify-content: center; }
.event-card h2 { margin: 11px 0 12px; font-size: 30px; line-height: 1.1; }
.event-card p { margin: 0; color: #79869b; font-size: 12px; line-height: 1.7; }
.event-meta { margin: 22px 0; display: flex; flex-wrap: wrap; gap: 14px; color: #aab4c5; font-size: 10px; font-weight: 700; }
.event-meta span { display: inline-flex; align-items: center; gap: 6px; }
.event-card .button { align-self: flex-start; }
.cta-section { margin: 0 8vw 82px; padding: 42px 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; border: 1px solid rgba(227,27,45,.22); border-radius: 18px; background: radial-gradient(circle at 20% 50%,rgba(227,27,45,.13),transparent 30%), #101827; }
.cta-section h2 { max-width: 620px; margin: 8px 0 0; font-size: 27px; }
.footer { min-height: 118px; padding: 0 8vw; display: flex; align-items: center; gap: 26px; border-top: 1px solid #172131; background: #070b13; }
.brand--footer { min-width: 220px; }
.footer p { flex: 1; color: #687489; font-size: 10px; }
.footer > a { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid #273247; border-radius: 8px; color: #8995a8; }
@media (max-width: 980px) {
  .main-nav { display: none; }
  .hero { grid-template-columns: 1fr; padding-top: 68px; }
  .hero__content { text-align: center; }
  .hero__content > p { margin-inline: auto; }
  .hero__actions { justify-content: center; }
  .hero__visual { min-height: 340px; }
  .advantage-grid { grid-template-columns: 1fr; }
  .event-card { grid-template-columns: 1fr; }
  .event-card__visual { min-height: 260px; }
}
@media (max-width: 700px) {
  .topbar { height: auto; min-height: 72px; padding: 12px 18px; }
  .brand { min-width: 0; }
  .brand strong { font-size: 11px; }
  .top-actions .button--ghost { display: none; }
  .top-actions .button { padding-inline: 12px; }
  .hero { padding: 62px 20px 48px; }
  .hero h1 { font-size: 44px; }
  .hero__actions { flex-direction: column; }
  .stats { padding: 0; grid-template-columns: 1fr; }
  .stats article { min-height: 96px; border-right: 0; border-bottom: 1px solid #1b2637; }
  .section { padding: 64px 20px; }
  .section-heading--split { align-items: flex-start; flex-direction: column; }
  .game-grid { grid-template-columns: 1fr; }
  .event-card__content { padding: 30px 24px; }
  .cta-section { margin: 0 20px 60px; padding: 30px 24px; align-items: flex-start; flex-direction: column; }
  .footer { padding: 30px 20px; align-items: flex-start; flex-direction: column; }
}

