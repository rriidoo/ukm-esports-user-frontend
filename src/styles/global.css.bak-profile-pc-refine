  font-size: 22px;
  line-height: 1.2;
}
.user-profile-stat-card strong.is-green {
  color: #20d76b;
}
.user-profile-stat-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: #111d31;
  color: #b7c2d3;
}
.user-profile-stat-icon svg {
  width: 27px;
  height: 27px;
}
.user-profile-stat-icon--green {
  background: #0d4825;
  color: #24df79;
}

.user-profile-section-head {
  margin-top: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}
.user-profile-section-head h2 {
  margin: 0;
  font-size: 18px;
  line-height: 1.3;
  letter-spacing: .7px;
}
.user-profile-section-head > span {
  padding: 7px 16px;
  border: 1px solid #23334e;
  border-radius: 999px;
  background: #101a2d;
  color: #7f8ba0;
  font-size: 14px;
}
.user-profile-games {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.user-profile-game-card {
  min-height: 116px;
  padding: 24px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border: 1px solid #23334e;
  border-radius: 24px;
  background: #101a2d;
}
.user-profile-game-card h3 {
  margin: 0;
  font-size: 20px;
  line-height: 1.3;
}
.user-profile-game-card p {
  margin: 6px 0 0;
  color: #9aa6ba;
  font-size: 16px;
}
.user-profile-status {
  min-width: 116px;
  padding: 8px 14px;
  border-radius: 999px;
  text-align: center;
  font-size: 14px;
  font-weight: 800;
}
.user-profile-status--accepted {
  background: #0c4b25;
  color: #20d76b;
}
.user-profile-status--verify {
  background: #5c3d00;
  color: #ffb514;
}

.user-profile-add-game {
  width: 100%;
  min-height: 68px;
  margin-top: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid #23334e;
  border-radius: 18px;
  background: #101a2d;
  color: #ff9ca5;
  font-size: 18px;
  font-weight: 700;
}
.user-profile-add-game svg {
  width: 24px;
  height: 24px;
}
.user-profile-logout {
  width: max-content;
  margin: 28px auto 0;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #ff4051;
  font-size: 18px;
  font-weight: 700;
}
.user-profile-logout svg {
  width: 24px;
  height: 24px;
}

.user-profile-help {
  margin: 250px auto 0;
  text-align: center;
}
.user-profile-help > p {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #f5f7fb;
  font-size: 16px;
}
.user-profile-help > p svg {
  width: 23px;
  height: 23px;
  color: #1cd673;
}
.user-profile-help > p strong {
  font-weight: 800;
}
.user-profile-help > p span {
  font-weight: 400;
}
.user-profile-help > a {
  width: max-content;
  min-height: 46px;
  margin: 20px auto 0;
  padding: 0 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid #23334e;
  border-radius: 999px;
  background: #101a2d;
  color: #1bdc70;
  font-size: 18px;
  font-weight: 700;
}
.user-profile-help > a svg {
  width: 20px;
  height: 20px;
}
.user-profile-copyright {
  max-width: 760px;
  margin: 260px auto 0;
  padding: 0 24px 30px;
  color: #71809a;
  font-size: 12px;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 700px) {
  .user-profile-page {
    width: 390px;
    max-width: 100%;
    min-height: 100dvh;
    margin: 0 auto;
    overflow-x: hidden;
  }
  .user-profile-header {
    height: 69px;
    grid-template-columns: 42px 1fr 42px;
    gap: 9px;
    padding: 0 20px;
  }
  .user-profile-back,
  .user-profile-account {
    width: 39px;
    height: 39px;
    border-radius: 13px;
  }
  .user-profile-back svg {
    width: 21px;
    height: 21px;
  }
  .user-profile-account img {
    width: 31px;
    height: 31px;
  }
  .user-profile-heading {
    gap: 3px;
  }
  .user-profile-heading strong {
    font-size: 10px;
    letter-spacing: 2.6px;
  }
  .user-profile-heading span {
    font-size: 12px;
  }

  .user-profile-wrap {
    width: calc(100% - 32px);
    margin-top: 20px;
  }
  .user-profile-card {
    min-height: 112px;
    grid-template-columns: 58px 1fr 34px;
    gap: 14px;
    padding: 18px 16px;
    border-radius: 18px;
  }
  .user-profile-avatar {
    width: 50px;
    height: 50px;
    font-size: 16px;
  }
  .user-profile-name-row {
    gap: 5px;
  }
  .user-profile-name-row h1 {
    font-size: 16px;
    line-height: 1.2;
  }
  .user-profile-name-row svg {
    width: 16px;
    height: 16px;
  }
  .user-profile-copy > p {
    margin: 4px 0 2px;
    font-size: 14px;
    line-height: 1.35;
  }
  .user-profile-copy > small {
    font-size: 12px;
  }
  .user-profile-card-slot {
    width: 34px;
    height: 34px;
    border-radius: 12px;
  }

  .user-profile-stats {
    margin-top: 24px;
    gap: 14px;
  }
  .user-profile-stat-card {
    min-height: 92px;
    padding: 18px 16px;
    border-radius: 18px;
  }
  .user-profile-stat-card span {
    font-size: 12px;
    line-height: 1.4;
  }
  .user-profile-stat-card strong {
    margin-top: 5px;
    font-size: 16px;
  }
  .user-profile-stat-icon {
    width: 38px;
    height: 38px;
    border-radius: 13px;
  }
  .user-profile-stat-icon svg {
    width: 20px;
    height: 20px;
  }

  .user-profile-section-head {
    margin-top: 34px;
  }
  .user-profile-section-head h2 {
    font-size: 14px;
  }
  .user-profile-section-head > span {
    padding: 6px 12px;
    font-size: 12px;
  }
  .user-profile-games {
    margin-top: 14px;
    gap: 14px;
  }
  .user-profile-game-card {
    min-height: 70px;
    padding: 16px 14px;
    border-radius: 18px;
  }
  .user-profile-game-card h3 {
    font-size: 14px;
  }
  .user-profile-game-card p {
    margin-top: 4px;
    font-size: 13px;
  }
  .user-profile-status {
    min-width: 88px;
    padding: 7px 12px;
    font-size: 12px;
  }

  .user-profile-add-game {
    min-height: 48px;
    margin-top: 16px;
    border-radius: 14px;
    font-size: 14px;
  }
  .user-profile-add-game svg {
    width: 18px;
    height: 18px;
  }
  .user-profile-logout {
    margin-top: 20px;
    font-size: 14px;
  }
  .user-profile-logout svg {
    width: 18px;
    height: 18px;
  }

  .user-profile-help {
    margin-top: 180px;
  }
  .user-profile-help > p {
    gap: 5px;
    font-size: 13px;
  }
  .user-profile-help > p svg {
    width: 18px;
    height: 18px;
  }
  .user-profile-help > a {
    min-height: 36px;
    margin-top: 16px;
    padding: 0 16px;
    font-size: 14px;
  }
  .user-profile-help > a svg {
    width: 16px;
    height: 16px;
  }
  .user-profile-copyright {
    margin-top: 220px;
    padding-bottom: 26px;
    font-size: 10.5px;
  }
}

@media (max-width: 359px) {
  .user-profile-stats {
    grid-template-columns: 1fr;
  }
}
