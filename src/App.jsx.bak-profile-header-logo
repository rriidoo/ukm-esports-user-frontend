function UploadDocumentsPage() {
  const [ktmFile, setKtmFile] = useState({ name: 'ktm_rido_sihombing.pdf', size: '1.4 MB', progress: 65 });
  const [followFile, setFollowFile] = useState({ name: 'bukti_follow.png', size: '850 KB', verified: true });

  const pickFile = (setter, verified = false) => (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const size = file.size ? `${(file.size / (1024 * 1024)).toFixed(file.size > 1024 * 1024 ? 1 : 2)} MB` : '';
    setter(verified
      ? { name: file.name, size, verified: true }
      : { name: file.name, size, progress: 65 });
  };

  return (
    <main className="user-upload-page">
      <header className="user-upload-header">
        <a className="user-upload-back" href="#informasi-personal" aria-label="Kembali ke informasi personal"><ChevronLeft /></a>
        <div className="user-upload-heading">
          <strong>UKM ESPORTS</strong>
          <span>TEL-U PURWOKERTO</span>
        </div>
        <div className="user-upload-logo"><img src={logo} alt="Tel-U Esports" /></div>
      </header>

      <section className="user-upload-wrap">
        <h1>Unggah Dokumen</h1>
        <p className="user-upload-subtitle">Unggah dokumen identitas dan bukti keanggotaan untuk validasi kurasi tim UKM Esports Tel-U Purwokerto.</p>

        <section className="user-upload-card">
          <div className="user-upload-card-head">
            <h2>Kartu Tanda Mahasiswa (KTM)</h2>
            <span className="user-upload-required">Wajib</span>
          </div>

          <label className="user-upload-dropzone">
            <input type="file" accept=".jpg,.jpeg,.png,.pdf" onChange={pickFile(setKtmFile)} />
            <span className="user-upload-circle user-upload-circle--cyan"><UploadCloud /></span>
            <strong>Pilih berkas atau tarik ke sini</strong>
            <small>Format JPG, PNG, PDF (Maks. 2MB)</small>

            {ktmFile && (
              <div className="user-upload-file-block">
                <div className="user-upload-file-row">
                  <span className="user-upload-filetype">PDF</span>
                  <span className="user-upload-filename">{ktmFile.name}</span>
                  <strong>{ktmFile.progress}%</strong>
                </div>
                <div className="user-upload-progress"><i style={{ width: `${ktmFile.progress}%` }} /></div>
                <div className="user-upload-meta">
                  <span>Ukuran: {ktmFile.size}</span>
                  <button type="button" onClick={(e) => { e.preventDefault(); setKtmFile(null); }}>Batalkan</button>
                </div>
              </div>
            )}
          </label>
        </section>

        <section className="user-upload-card">
          <div className="user-upload-card-head">
            <h2>Tangkapan Layar Follow IG <small>@telupwt.esport</small></h2>
            <span className="user-upload-required">Wajib</span>
          </div>

          <div className="user-upload-verified">
            <span className="user-upload-circle user-upload-circle--green"><img src={uploadCheckLargeIcon} alt="" /></span>

            {followFile && (
              <div className="user-upload-file-pill">
                <ImageIcon />
                <span>{followFile.name}</span>
                <small>({followFile.size})</small>
              </div>
            )}

            <label className="user-upload-change">
              <input type="file" accept=".jpg,.jpeg,.png" onChange={pickFile(setFollowFile, true)} />
              <RefreshCcw />
              <span>Ganti Berkas</span>
            </label>

            <p><img className="user-upload-check-small" src={uploadCheckSmallIcon} alt="" /> Berkas terverifikasi otomatis oleh sistem</p>
          </div>
        </section>

        <aside className="user-upload-warning">
          <img className="user-upload-warning-icon" src={uploadWarningIcon} alt="" />
          <div>
            <strong>Penting: Verifikasi Identitas</strong>
            <p>Pastikan nama di KTM sesuai dengan <b>Nama Lengkap</b> pada data diri. Dokumen yang tidak valid dapat menyebabkan diskualifikasi dari turnamen mendatang.</p>
          </div>
        </aside>

        <button className="user-upload-primary" type="button" onClick={() => { window.location.hash = 'pendaftaran-berhasil'; }}>Submit Dokumen</button>
        <a className="user-upload-secondary" href="#informasi-personal">Kembali</a>
      </section>

      <p className="user-upload-copyright">© 2026 Telkom University Purwokerto Esports. All rights reserved.</p>
    </main>
  );
}



